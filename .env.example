# Copy to .env and fill in values from your own Supabase project.
# Never commit real keys. Publishable keys are safe in the browser; the service role key is NOT.

# --- Browser (exposed to the client bundle) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server only (read inside server functions / routes) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref
# Required for monitoring configuration, scrapes and the scheduled job.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Bearer secret that authorizes the scheduled scrape endpoint (/api/public/jobs/scrape-prometheus).
LOVABLE_CRON_SECRET=replace-with-a-long-random-string
